<?xml version="1.0" encoding="UTF-8" ?>
<publication>
  <common>
    <!-- Level at which are html files generated (chapter/section/etc): -->
    <chunking level="1" />
    <!-- Depth for table of contents.  0 means no TOC -->
    <tableofcontents level="2" />
  </common>

  <!-- directories are relative to the main source PreTeXt file -->
  <source>
    <!-- The external directory is declared in source/docinfo.ptx -->
    <directories generated="../generated-assets"/>
    <!-- Version flags -->
    <!-- homework: Course has SBG homework -->
    <!-- BARC: Course has university tutoring resources -->
    <!-- mathclub: Course has club tutoring resources -->
    <version include="homework BARC mathclub"/>
  </source>
  
  <latex print="no" sides="one" font-size="10" draft="no">
    <page right-alignment="flush" bottom-alignment="ragged">
      <geometry>margin={1in}</geometry>
    </page>
  </latex>

  <html favicon="simple">
    <brandlogo url="https://latech.edu" source="images/logo.png"/>
    <!-- Vintage Tech blue main color; a lightened Vintage Tech red (#B73E26) for
	 the dark theme, tinted to clear the 4.5:1 contrast ratio against the
	 theme's dark background. -->
    <css theme="boulder" primary-color="#0A3254" primary-color-dark="#D9705A"/>
  </html>
</publication>
