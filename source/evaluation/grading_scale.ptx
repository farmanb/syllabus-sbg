<?xml version="1.0" encoding="utf-8"?>
<subsection xml:id="grading_scale">
  <title>Grading Scale</title>

  <p>
    Letter grades will be assigned based on the number of standards mastered in the course, as specified in the table below.
  </p>

  <assemblage>
    <title>Grading Scale</title>
    <tabular halign="center">
      <row header="yes" bottom="minor">
	<cell>Number of Standards Mastered</cell>
	<cell>Letter Grade</cell>
      </row>
      <row>
	<cell>17<ndash/>18</cell>
	<cell>A</cell>
      </row>
      <row>
	<cell>15<ndash/>16</cell>
	<cell>B</cell>
      </row>
      <row>
	<cell>13<ndash/>14</cell>
	<cell>C</cell>
      </row>
      <row>
	<cell>11<ndash/>12</cell>
	<cell>D</cell>
      </row>
      <row>
	<cell>0<ndash/>10</cell>
	<cell>F</cell>
      </row>
    </tabular>
  </assemblage>
</subsection>
